# ==============================================================
# Knots — Environment Variables Guide (.env)
# ==============================================================
# Copy this file to .env (or configure in Render Environment Settings)

# --------------------------------------------------------------
# 1. SERVER CONFIGURATION
# --------------------------------------------------------------
PORT=3000
NODE_ENV=production

# --------------------------------------------------------------
# 2. PRIMARY DATABASE (MongoDB Atlas) [RECOMMENDED]
# --------------------------------------------------------------
# Knots stores encrypted key registries, contact handshakes, and offline message queues.
# If omitted, Knots operates in ephemeral in-memory RAM fallback mode.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/knots?retryWrites=true&w=majority

# --------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# --------------------------------------------------------------
# Secret key used for signing internal tokens (any strong random 32+ char string)
JWT_SECRET=replace_with_a_long_random_secret_key_here

# --------------------------------------------------------------
# 4. CLOUDINARY ZERO-KNOWLEDGE MEDIA [FREE TIER ZERO-SERVER LOAD]
# --------------------------------------------------------------
# Keeps your Render bandwidth & MongoDB storage usage at 0% for images/video/voice notes.
# Can also be set in-app via: //cloud <cloud_name> <unsigned_preset>
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# --------------------------------------------------------------
# 5. FRONTEND / CLIENT CONFIGURATION [OPTIONAL]
# --------------------------------------------------------------
# ONLY needed if you host the frontend separately (e.g. Vercel / Netlify / Cloudflare Pages).
# If you deploy full-stack on a single service (Render / Railway / VPS), leave this blank.
# VITE_API_BASE=https://your-relay-domain.onrender.com

# --------------------------------------------------------------
# 6. SUPABASE INTEGRATION [OPTIONAL DUAL-WRITE BACKUP]
# --------------------------------------------------------------
# Optional dual-write registry. Not required for Knots to run.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --------------------------------------------------------------
# 7. ABLY REALTIME [OPTIONAL LEGACY FALLBACK]
# --------------------------------------------------------------
# Knots uses native Server-Sent Events (SSE). Ably is optional.
ABLY_API_KEY=
