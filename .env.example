# ==============================================================
# Knots — Environment Variables Guide (.env)
# ==============================================================

# --- Server Configuration ---
PORT=3000
NODE_ENV=production

# --- Primary Database (MongoDB Atlas) [RECOMMENDED] ---
# Knots stores encrypted key registries, contact handshakes, and offline message queues.
# If omitted, Knots operates in ephemeral in-memory RAM fallback mode.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/knots?retryWrites=true&w=majority

# --- Supabase Integration [OPTIONAL] ---
# Optional dual-write backup registry. Not required for Knots to run.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# --- Decoupled Frontend [OPTIONAL] ---
# ONLY needed if you deploy the frontend separately (e.g. Vercel / Netlify / Cloudflare Pages).
# If you deploy as a single service (Render / Railway / VPS), leave this blank.
# VITE_API_BASE=https://your-relay-domain.onrender.com
