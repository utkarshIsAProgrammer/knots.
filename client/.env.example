# ==============================================================
# Knots Client Environment Variables (.env)
# ==============================================================

# Backend Relay Base URL
# Leave blank if client is served by the same Express server on Render.
# Set only if client is deployed separately on Vercel, Netlify, or Cloudflare Pages.
# VITE_API_BASE=https://your-relay-domain.onrender.com

# Cloudinary Zero-Knowledge Media Storage (Free 25GB/month, 0% Render server load)
# Can also be set directly in-chat with: //cloud <cloud_name> <unsigned_preset>
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
