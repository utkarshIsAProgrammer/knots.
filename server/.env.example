# ==============================================================
# Knots Server Environment Variables (.env)
# ==============================================================

# Server Network Config
PORT=3000
NODE_ENV=production

# Primary Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/knots?retryWrites=true&w=majority

# JWT Token Secret
JWT_SECRET=replace_with_a_long_random_secret_key_here

# Web Push (VAPID) — required for notifications while the app is closed.
# Generate a key pair once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Supabase (Optional dual-write backup)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Ably (Optional legacy fallback)
ABLY_API_KEY=
